#!/bin/sh
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

if command -v pwsh >/dev/null 2>&1; then
    pwsh -NoProfile -ExecutionPolicy Bypass -File "$REPO_ROOT/setprofile.ps1" -BuildOnly
else
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$REPO_ROOT/setprofile.ps1" -BuildOnly
fi

git add "$REPO_ROOT/Microsoft.PowerShell_profile.ps1"

